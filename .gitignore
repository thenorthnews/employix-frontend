# ==============================================================
# Employix Frontend - Files To NOT Push To Server / Git
# ==============================================================

# 1. Dependencies (Installed via `npm install` on server)
node_modules/
.pnp
.pnp.js

# 2. Local Environment Variables (Contains local API URLs like localhost:5000)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 3. Local Build Output (Build will be generated on server via `npm run build`)
dist/
dist-ssr/
build/
out/

# 4. Vite & Compiler Cache
.vite/
.cache/
.parcel-cache/

# 5. Logs & Error Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 7. IDE & Local Editor Configurations
.vscode/
.idea/
*.sublime-*
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
